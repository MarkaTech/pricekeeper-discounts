// PriceKeeper Discounts — database schema
// Dev: SQLite. Production: swap provider to "postgresql" and set DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Shopify session storage (required by @shopify/shopify-app-session-storage-prisma)
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Shop {
  id               String   @id @default(cuid())
  domain           String   @unique // the-shop.myshopify.com
  timezone         String   @default("UTC")
  currency         String   @default("USD")
  planTier         String   @default("FREE") // FREE | GROWTH | PRO
  billingInterval  String? // MONTHLY | ANNUAL
  subscriptionId   String? // Shopify AppSubscription GID
  installedAt      DateTime @default(now())
  uninstalledAt    DateTime?

  campaigns        Campaign[]
  widgetSettings   WidgetSettings?
}

model Campaign {
  id                 String   @id @default(cuid())
  shopId             String
  shop               Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  name               String
  type               String   // PERCENTAGE | FIXED_AMOUNT | NEW_PRICE | VOLUME | BOGO | CART_TOTAL | FREE_SHIPPING
  status             String   @default("DRAFT") // DRAFT | ACTIVE | PAUSED | ENDED
  configJson         String   // serialized CampaignConfig — engine's single source of truth
  discountId         String?  // Shopify DiscountAutomaticApp GID once activated

  startsAt           DateTime?
  endsAt             DateTime?
  recurrence         String?  // NONE | DAILY | WEEKLY | MONTHLY

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  dailyStats         CampaignDailyStat[]

  @@index([shopId, status])
}

model CampaignDailyStat {
  id             String   @id @default(cuid())
  campaignId     String
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date           DateTime
  orderCount     Int      @default(0)
  revenue        Float    @default(0)
  discountTotal  Float    @default(0)
  currency       String

  @@unique([campaignId, date, currency])
}

model ShopDailyStat {
  id             String   @id @default(cuid())
  shopDomain     String
  date           DateTime
  orderCount     Int      @default(0)
  revenue        Float    @default(0)
  discountTotal  Float    @default(0)
  currency       String

  @@unique([shopDomain, date, currency])
  @@index([shopDomain])
}

model WidgetSettings {
  id             String   @id @default(cuid())
  shopId         String   @unique
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  accentColor    String   @default("#111111")
  showPriceBadge Boolean  @default(true)
  showTierTable  Boolean  @default(true)
  showBogoBadge  Boolean  @default(true)
  showCountdown  Boolean  @default(true)
  showShippingBar Boolean @default(true)
  updatedAt      DateTime @updatedAt
}

// Webhook dedup — Shopify webhook IDs only, no payload contents
model ProcessedWebhook {
  id          String   @id // Shopify's X-Shopify-Webhook-Id
  topic       String
  shopDomain  String
  processedAt DateTime @default(now())

  @@index([shopDomain])
}
