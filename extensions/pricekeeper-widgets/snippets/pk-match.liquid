{%- comment -%}
  Shared targeting matcher, included by every block. Reads the display-only
  `pricekeeper.active_campaigns` shop metafield (collection/product IDs only
  — never enumerates a collection's products) and decides whether the
  current product/variant is covered by any active campaign.

  Display-only: this never determines what the customer actually pays.
  Checkout (the Shopify Function) is always the pricing authority, even if
  this Liquid snippet's decision drifted from it for any reason.
{%- endcomment -%}

{%- assign pk_campaigns = shop.metafields.pricekeeper.active_campaigns.value -%}
{%- assign pk_matched_campaign = blank -%}

{%- if pk_campaigns -%}
  {%- for campaign in pk_campaigns -%}
    {%- assign pk_in_collection = false -%}
    {%- for collection in product.collections -%}
      {%- if campaign.collectionIds contains collection.id -%}
        {%- assign pk_in_collection = true -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if campaign.productIds contains product.id or pk_in_collection -%}
      {%- assign pk_matched_campaign = campaign -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
